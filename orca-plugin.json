{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "colab",
  "name": "Colab GPU (Community) for Orca",
  "version": "0.4.4",
  "description": "Give Claude Code, Codex and your other Orca agents a Google Colab GPU: launch T4, L4 or A100 runtimes, sync code, run training jobs and pull results back.",
  "repository": "https://github.com/vzxxbacq/orca-colab",
  "license": "MIT",
  "homepage": "https://vzxxbacq.github.io/orca-colab/",
  "author": { "name": "vzxxbacq", "url": "https://github.com/vzxxbacq" },
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "The Colab GPU panel in Orca: agent runs, guardrails and live output of a job on a Tesla T4"
  },
  "engines": { "orca": ">=1.4.248" },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "colab",
        "title": "Colab GPU",
        "icon": "zap",
        "entry": "panel/index.html"
      }
    ],
    "commands": [
      {
        "id": "colab.up",
        "title": "Colab: Start GPU session"
      },
      {
        "id": "colab.down",
        "title": "Colab: Stop GPU session"
      },
      {
        "id": "colab.showPanel",
        "title": "Colab: Show sessions"
      }
    ],
    "statusBarItems": [
      {
        "id": "colab-sessions",
        "icon": "zap",
        "text": "Colab",
        "command": "colab.showPanel"
      }
    ],
    "settings": [
      {
        "key": "autoStopIdleMinutes",
        "title": "Auto-stop idle sessions after (minutes)",
        "type": "integer",
        "default": 20,
        "minimum": 0
      },
      {
        "key": "cliCommand",
        "title": "orca-colab command",
        "description": "The orca-colab command the panel shows for you to paste into a terminal of your own (for example a full interactive shell on a runtime). The panel itself talks to Colab directly and does not run it.",
        "type": "string",
        "default": "npx -y https://codeload.github.com/vzxxbacq/orca-colab/tar.gz/621b5c5e58328fa5e3aa67482f8985290c8f4c3b"
      }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "notifications:show" },
    { "kind": "settings:own" }
  ]
}
